{
	"schemaVersion": 1,
	"id": "quickblock",
	"version": "${version}",
	"name": "Quick Block",
	"description": "Đặt block nhanh hơn, nén vật thể nhanh (thuốc, trai kinh nghiệm), và giảm lag cho game!",
	"authors": [
		"Fabric Developer"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/quickblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.QuickBlockMod"
		],
		"client": [
			"com.example.QuickBlockClient"
		]
	},
	"mixins": [
		"quickblock.mixins.json",
		{
			"config": "quickblock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}